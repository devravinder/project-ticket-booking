# Local defaults (no secrets: the passwords exist only in the local containers).
PORT=7002
SERVICE_NAME=payment-gateway
DATABASE_URL=postgres://gateway_svc:gateway@localhost:5435/gateway
PUBLIC_URL=http://localhost:7002
# Local-only signing key; must match the booking service's WEBHOOK_SECRET.
WEBHOOK_SECRET=whsec_local_dev_only_change_me
