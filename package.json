{
  "name": "project-ticket-booking",
  "private": true,
  "version": "0.0.0",
  "description": "Learning-oriented movie ticket booking - seat holds, live seat map, payment webhooks",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "start:pods": "docker compose -f infra/docker-compose.yaml up -d --wait",
    "stop:pods": "docker compose -f infra/docker-compose.yaml down",
    "reset:pods": "docker compose -f infra/docker-compose.yaml down -v",
    "logs:pods": "docker compose -f infra/docker-compose.yaml logs -f",
    "start:services": "pnpm -r --parallel --filter @tix/booking-service --filter @tix/payment-gateway --filter @tix/web run \"/^dev(:2)?$/\"",
    "start:booking": "pnpm --filter @tix/booking-service dev",
    "start:booking:2": "pnpm --filter @tix/booking-service dev:2",
    "start:gateway": "pnpm --filter @tix/payment-gateway dev",
    "start:web": "pnpm --filter @tix/web dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules\"",
    "format:md": "markdownlint-cli2 --fix \"**/*.md\" \"#**/node_modules\""
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "markdownlint-cli2": "0.15.0",
    "oxlint": "1.92.0",
    "prettier": "3.9.10"
  }
}
